{
  "name": "mason",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @mason/server\" \"npm run dev -w @mason/web\"",
